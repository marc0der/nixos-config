{
  "model": "opus",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Working"]
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "WebSearch",
      "Bash(systemctl *)",
      "Bash(rclone bisync *)",
      "Bash(lsblk *)",
      "Bash(cat *)",
      "Bash(chmod *)",
      "Bash(nixfmt *)",
      "Bash(curl *)",
      "Bash(nix-rebuild-home *)",
      "Bash(nix-rebuild-system *)",
      "Bash(nix-rebuild-all *)",
      "Bash(nix-upgrade-all *)",

      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(column *)",
      "Bash(od *)",
      "Bash(xxd *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(basename *)",
      "Bash(dirname *)",

      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(hostname)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(mkdir *)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git describe *)",
      "Bash(git stash list)",
      "Bash(git add *)",

      "Bash(nix eval *)",
      "Bash(nix flake metadata *)",
      "Bash(nix flake show *)",
      "Bash(nix flake check *)",
      "Bash(nix search *)",
      "Bash(nix path-info *)",
      "Bash(nix-store --query *)",
      "Bash(nix-instantiate *)",
      "Bash(nix fmt)",
      "Bash(nix fmt *)",
      "Bash(nvd diff *)",
      "Bash(nix-env --list-generations *)",
      "Bash(home-manager generations *)",
      "Bash(nixos-version)",

      "Bash(nix-changed-layers)",
      "Bash(nix-changed-layers *)",
      "Bash(nix-doctor)",
      "Bash(nix-doctor *)",
      "Bash(nix-generations)",
      "Bash(nix-generations *)",
      "Bash(nix-build-check)",
      "Bash(nix-build-check *)",
      "Bash(nix-host-parity)",
      "Bash(nix-host-parity *)",
      "Bash(nix-purge --dry-run)",
      "Bash(nix-purge --dry-run *)",
      "Bash(nix-rebuild-home)",
      "Bash(nix-rebuild-system)",
      "Bash(nix-rebuild-all)",
      "Bash(nix-upgrade-all)",

      "Bash(journalctl *)",
      "Bash(pgrep *)",
      "Bash(ps *)",
      "Bash(pidof *)",
      "Bash(hyprctl binds *)",
      "Bash(hyprctl clients *)",
      "Bash(hyprctl monitors *)",
      "Bash(hyprctl version *)",
      "Bash(hyprctl getoption *)",
      "Bash(Hyprland --verify-config)",

      "mcp__git-mcp__git_status",
      "mcp__git-mcp__git_diff",
      "mcp__git-mcp__git_diff_staged",
      "mcp__git-mcp__git_diff_unstaged",
      "mcp__git-mcp__git_log",
      "mcp__git-mcp__git_show",
      "mcp__git-mcp__git_branch",
      "Skill(commit)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(dd if=*)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "ask": []
  },
  "promptSuggestionEnabled": false,
  "enableAllProjectMcpServers": false,
  "outputStyle": "default",
  "spinnerTipsEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/meterstick-command.sh"
  }
}
