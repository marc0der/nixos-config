#!/usr/bin/env bash
#
# Nix Purge
#
# Deletes profile generations older than KEEP_DAYS from the user, home-manager
# and system profiles, drops stale build symlinks, then collects the store.
# The newest generation older than the active one is always retained as a
# rollback target, even when it is older than KEEP_DAYS, so a purge never leaves
# the active generation with nothing to fall back to. Generations newer than the
# active one, such as the one a rollback fled from, age out like any other.
#
# Usage:
#   nix-purge [KEEP_DAYS] [--dry-run]   (default: 7)

set -euo pipefail

KEEP_DAYS=7
DRY_RUN=no
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=yes ;;
    *) KEEP_DAYS="$arg" ;;
  esac
done
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SYSTEM_PROFILE="/nix/var/nix/profiles/system"
XDG_USER_PROFILE="${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/profile"

# ~/.nix-profile may be a chain of symlinks ending profile -> generation ->
# store path; the profile is the last link before the generation link
resolve_profile() {
  local link="$1" prev="$1" target
  while [ -L "$link" ]; do
    target="$(readlink "$link")"
    [[ "$target" == /* ]] || target="$(dirname "$link")/$target"
    [ -L "$target" ] || break
    prev="$link"
    link="$target"
  done
  printf '%s\n' "$prev"
}

if [ -L "$HOME/.nix-profile" ]; then
  USER_PROFILE="$(resolve_profile "$HOME/.nix-profile")"
else
  USER_PROFILE="$XDG_USER_PROFILE"
fi

if ! [[ "$KEEP_DAYS" =~ ^[0-9]+$ ]]; then
  echo "usage: nix-purge [KEEP_DAYS] [--dry-run]" >&2
  exit 1
fi

CUTOFF="$(date -d "-${KEEP_DAYS} days" +%s)"

# Fail fast rather than blocking on a password prompt
for cmd in nix nix-env; do
  [ "$DRY_RUN" = yes ] && break
  if ! sudo -n "$cmd" --version >/dev/null 2>&1; then
    echo "error: passwordless sudo for '$cmd' is missing" >&2
    echo "       add it to security.sudo.extraRules in configuration.nix" >&2
    exit 1
  fi
done

# Echo every inactive generation number of a profile, newest first
inactive_generations() {
  local profile="$1" active link nums=()
  active="$(basename "$(readlink "$profile" 2>/dev/null || true)")"
  for link in "$profile"-*-link; do
    [ -L "$link" ] || continue
    [ "$(basename "$link")" = "$active" ] && continue
    [[ "$(basename "$link")" =~ -([0-9]+)-link$ ]] || continue
    nums+=("${BASH_REMATCH[1]}")
  done
  # must succeed even with no inactive generations: pipefail would otherwise
  # abort the caller's `keep="$(rollback_target ...)"` assignment
  if [ "${#nums[@]}" -gt 0 ]; then
    printf '%s\n' "${nums[@]}" | sort -rn
  fi
  return 0
}

# Echo the generation kept as a rollback target: the newest one older than the
# active generation
rollback_target() {
  local profile="$1" active num
  [[ "$(readlink "$profile" 2>/dev/null || true)" =~ -([0-9]+)-link$ ]] || return 0
  active="${BASH_REMATCH[1]}"
  while read -r num; do
    [ -n "$num" ] || continue
    if [ "$num" -lt "$active" ]; then
      printf '%s\n' "$num"
      break
    fi
  done < <(inactive_generations "$profile")
  return 0
}

# Echo generation numbers older than the cutoff, skipping the active one and
# the rollback target
stale_generations() {
  local profile="$1" keep num
  keep="$(rollback_target "$profile")"
  while read -r num; do
    [ -n "$num" ] || continue
    [ "$num" = "$keep" ] && continue
    [ "$(stat -c %Y "$profile-$num-link")" -ge "$CUTOFF" ] && continue
    printf '%s\n' "$num"
  done < <(inactive_generations "$profile")
}

# Delete stale generations from a profile, optionally via sudo
purge_profile() {
  local profile="$1" as_root="$2" gens keep
  keep="$(rollback_target "$profile")"
  mapfile -t gens < <(stale_generations "$profile")
  if [ "${#gens[@]}" -eq 0 ]; then
    echo "  nothing older than $KEEP_DAYS days"
  else
    if [ "$DRY_RUN" = yes ]; then
      echo "  would delete generations: ${gens[*]}"
    else
      echo "  deleting generations: ${gens[*]}"
      if [ "$as_root" = root ]; then
        sudo -n nix-env -p "$profile" --delete-generations "${gens[@]}"
      else
        nix-env -p "$profile" --delete-generations "${gens[@]}"
      fi
    fi
  fi
  if [ -n "$keep" ]; then
    echo "  retaining generation $keep as a rollback target"
  else
    echo "  no generation older than the active one, so there is no rollback target"
  fi
}

# Delete stale home-manager generations, retaining the newest one older than
# the current generation.
# `home-manager expire-generations` keeps only the current generation, so the
# ids are selected here instead.
purge_home() {
  local line date_str id ts keep="" seen_current=no stale=()
  # home-manager generations lists newest first
  while IFS= read -r line; do
    [[ "$line" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2})\ :\ id\ ([0-9]+) ]] || continue
    date_str="${BASH_REMATCH[1]}"
    id="${BASH_REMATCH[2]}"
    case "$line" in
      *"(current)"*)
        seen_current=yes
        continue
        ;;
    esac
    if [ "$seen_current" = yes ] && [ -z "$keep" ]; then
      keep="$id"
      continue
    fi
    ts="$(date -d "$date_str" +%s)"
    [ "$ts" -ge "$CUTOFF" ] && continue
    stale+=("$id")
  done < <(home-manager generations)

  if [ "${#stale[@]}" -eq 0 ]; then
    echo "  nothing older than $KEEP_DAYS days"
  else
    if [ "$DRY_RUN" = yes ]; then
      echo "  would delete generations: ${stale[*]}"
    else
      echo "  deleting generations: ${stale[*]}"
      home-manager remove-generations "${stale[@]}"
    fi
  fi
  if [ -n "$keep" ]; then
    echo "  retaining generation $keep as a rollback target"
  else
    echo "  no generation older than the active one, so there is no rollback target"
  fi
}

echo "=== Nix Purge ==="
[ "$DRY_RUN" = yes ] && echo "DRY RUN: nothing will be deleted"
echo "Keeping generations from the last $KEEP_DAYS days,"
echo "plus the newest generation older than the active one as a rollback target"
echo ""

BEFORE="$(df --output=used /nix | tail -1)"

echo "Cleaning nix-env profile generations..."
purge_profile "$USER_PROFILE" user

echo ""
echo "Cleaning home-manager generations..."
purge_home

echo ""
echo "Cleaning system generations..."
purge_profile "$SYSTEM_PROFILE" root

echo ""
echo "Removing stale build symlinks..."
if [ "$DRY_RUN" = yes ]; then
  find "$REPO" -maxdepth 1 -type l \( -name result -o -name 'result-*' \) -print
else
  find "$REPO" -maxdepth 1 -type l \( -name result -o -name 'result-*' \) -print -delete
fi

echo ""
echo "Running garbage collection..."
if [ "$DRY_RUN" = yes ]; then
  echo "  skipped in a dry run"
else
  sudo -n nix store gc
fi

# Roots outside the profiles keep store paths alive regardless of generation age
echo ""
echo "Store paths still pinned by other GC roots:"
for link in /nix/var/nix/gcroots/auto/*; do
  [ -L "$link" ] || continue
  target="$(readlink "$link")"
  case "$target" in
    /nix/var/nix/profiles/* | */state/nix/profiles/* | */state/home-manager/*) continue ;;
    "$USER_PROFILE"-*-link) continue ;;
    *flake-registry.json) continue ;;
  esac
  [ -e "$target" ] && echo "  $target"
done

AFTER="$(df --output=used /nix | tail -1)"

# Calculate freed space in human-readable format
FREED_KB=$((BEFORE - AFTER))
if [ $FREED_KB -gt 1048576 ]; then
  FREED="$((FREED_KB / 1048576)) GB"
elif [ $FREED_KB -gt 1024 ]; then
  FREED="$((FREED_KB / 1024)) MB"
else
  FREED="$FREED_KB KB"
fi

echo ""
if [ "$DRY_RUN" = yes ]; then
  echo "=== Dry run complete, nothing was deleted ==="
else
  echo "=== Complete ==="
  echo "Freed approximately $FREED"
fi
