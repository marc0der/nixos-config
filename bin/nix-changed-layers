#!/usr/bin/env bash
#
# Nix Changed Layers
#
# Prints which configuration layers need a rebuild: `system`, `home`, both, or
# nothing. Files are attributed by looking up where flake.nix lists them, so
# mixed directories such as profiles/ resolve correctly. Anything else, assets
# and helper .nix files alike, takes the layer of whatever references it.
#
# Three different questions, answered by different means:
#   (default)     what have I edited but not built?   working tree vs HEAD,
#                                                     attributed per file
#   --unapplied   what is committed but not live?     the derivation HEAD
#                                                     evaluates to vs the one
#                                                     that built the live
#                                                     generation
#   --verify      did the last switch land?           the derivation the
#                                                     working tree evaluates
#                                                     to vs the live one
#
# Usage:
#   nix-changed-layers [--explain]
#   nix-changed-layers --unapplied [--explain]
#   nix-changed-layers --verify [--explain]

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EXPLAIN=no
MODE=edited
for arg in "$@"; do
  case "$arg" in
    --explain) EXPLAIN=yes ;;
    --unapplied) MODE=unapplied ;;
    --verify) MODE=verify ;;
    *)
      echo "usage: nix-changed-layers [--unapplied|--verify] [--explain]" >&2
      exit 1
      ;;
  esac
done

cd "$REPO"

# Compare the derivation a flake ref evaluates to against the one that produced
# the live generation. Timestamps cannot answer this, because committing after a
# switch makes an already-applied generation look stale.
if [ "$MODE" != edited ]; then
  HOST="$(hostname)"
  # a plain git+file:// ref evaluates the working tree; ?ref=HEAD pins the
  # comparison to what is actually committed
  if [ "$MODE" = unapplied ]; then
    FLAKE_REF="git+file://$REPO?ref=HEAD"
    SOURCE=HEAD
  else
    FLAKE_REF="git+file://$REPO"
    SOURCE="the working tree"
  fi
  HOME_PROFILE="${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager"

  # Unknowable state fails towards "needs applying": a spurious rebuild is a
  # no-op, whereas missing a real change is the bug this check exists to catch.
  layer_differs() {
    local layer="$1" attr="$2" live="$3" ref_drv live_drv
    if ! ref_drv="$(nix eval --raw --impure "$FLAKE_REF#$attr" 2>/dev/null)"; then
      echo "warning: cannot evaluate the $layer layer at $SOURCE" >&2
      return 0
    fi
    if [ ! -e "$live" ]; then
      echo "warning: no live $layer generation to compare against" >&2
      return 0
    fi
    live_drv="$(nix-store --query --deriver "$(readlink -f "$live")" 2>/dev/null || true)"
    if [ -z "$live_drv" ] || [ "$live_drv" = unknown-deriver ]; then
      echo "warning: deriver of the live $layer generation is unknown" >&2
      return 0
    fi
    [ "$ref_drv" != "$live_drv" ]
  }

  SYSTEM_ATTR="nixosConfigurations.$HOST.config.system.build.toplevel.drvPath"
  HOME_ATTR="homeConfigurations.\"$(id -un)@$HOST\".activationPackage.drvPath"

  for spec in "system|$SYSTEM_ATTR|/run/current-system" "home|$HOME_ATTR|$HOME_PROFILE"; do
    IFS='|' read -r layer attr live <<<"$spec"
    if layer_differs "$layer" "$attr" "$live"; then
      if [ "$EXPLAIN" = yes ]; then
        printf '  %-7s %s\n' "$layer" \
          "$SOURCE evaluates to a different derivation than the live generation" >&2
      fi
      echo "$layer"
    elif [ "$EXPLAIN" = yes ]; then
      printf '  %-7s %s\n' none "$layer layer is up to date with $SOURCE" >&2
    fi
  done
  exit 0
fi

CHANGED_FILE="$(mktemp)"
trap 'rm -f "$CHANGED_FILE"' EXIT

# staged, unstaged and untracked, rename targets included
git status --porcelain | sed 's/^...//' | sed 's/.* -> //' > "$CHANGED_FILE"

if [ ! -s "$CHANGED_FILE" ]; then
  if [ "$EXPLAIN" = yes ]; then echo "nothing to inspect" >&2; fi
  exit 0
fi

python3 - "$REPO/flake.nix" "$EXPLAIN" "$CHANGED_FILE" <<'PY'
import os, re, sys

flake_path, explain, changed_path = sys.argv[1], sys.argv[2] == "yes", sys.argv[3]
src = open(flake_path).read()
repo = os.path.dirname(flake_path)


def lists_after(anchor):
    """Entries of every bracketed list opened at each `anchor` occurrence."""
    entries = []
    for match in re.finditer(re.escape(anchor), src):
        # the anchor ends with "[", so locate it from the match start
        start = src.index("[", match.start()) + 1
        depth, end = 1, start
        while depth:
            if src[end] == "[":
                depth += 1
            elif src[end] == "]":
                depth -= 1
            end += 1
        entries += re.findall(r"^\s*(\S+)\s*$", src[start:end - 1], re.M)
    return entries


system_entries = set(lists_after("commonSystemModules = [")) | set(
    lists_after("modules = commonSystemModules ++ [")
)
home_entries = set(lists_after("commonHomeModules = [")) | set(
    lists_after("modules = commonHomeModules ++ [")
)


def module_layer(rel):
    """Layer a .nix module belongs to, or None when it is not a module."""
    ref = "./" + rel
    if ref in system_entries:
        return "system"
    if ref in home_entries:
        return "home"
    if rel == "configuration.nix":
        return "system"
    if rel == "home.nix":
        return "home"
    if rel.startswith("modules/system/"):
        return "system"
    if rel.startswith(("modules/home/", "shared/")):
        return "home"
    if rel.startswith("hosts/"):
        return "home" if rel.endswith("home.nix") else "system"
    return None


def asset_refs():
    """Non-module paths pulled in by flake.nix or a module, mapped to layers.

    flake.nix counts as both layers, and a helper .nix file passes its layers on
    to whatever it references in turn.
    """
    edges = {}
    for root, dirs, files in os.walk(repo):
        dirs[:] = [d for d in dirs if d != ".git"]
        for name in files:
            if not name.endswith(".nix"):
                continue
            full = os.path.join(root, name)
            targets = set()
            for literal in re.findall(r"\.{1,2}/[A-Za-z0-9_./+-]+", open(full).read()):
                resolved = os.path.normpath(os.path.join(os.path.dirname(full), literal))
                target = os.path.relpath(resolved, repo)
                if target.startswith("..") or module_layer(target) is not None:
                    continue
                targets.add(target)
            edges[os.path.relpath(full, repo)] = targets

    def owner_layers(rel):
        if rel == "flake.nix":
            return {"system", "home"}
        layer = module_layer(rel)
        return {layer} if layer else refs.get(rel, set())

    refs, changed = {}, True
    while changed:
        changed = False
        for importer, targets in edges.items():
            layers = owner_layers(importer)
            for target in targets:
                if not layers <= refs.get(target, set()):
                    refs.setdefault(target, set()).update(layers)
                    changed = True
    return refs


assets = asset_refs()


def classify(path):
    ref = "./" + path
    if path in ("flake.nix", "flake.lock"):
        return "both"
    if ref in system_entries:
        return "system"
    if ref in home_entries:
        return "home"
    if path.startswith("modules/system/"):
        return "system"
    if path.startswith(("modules/home/", "shared/")):
        return "home"
    if path.startswith("hosts/") and path.endswith("home.nix"):
        return "home"
    if path.startswith("hosts/"):
        return "system"
    # everything else: attribute to whatever references it
    for target, owners in assets.items():
        if path == target or path.startswith(target + "/"):
            return "both" if len(owners) > 1 else next(iter(owners))
    return "none"


layers, reasons = set(), []

for line in open(changed_path):
    path = line.strip()
    if not path:
        continue
    layer = classify(path)
    reasons.append((path, layer))
    if layer == "both":
        layers |= {"system", "home"}
    elif layer != "none":
        layers.add(layer)

if explain:
    for path, layer in sorted(reasons):
        print(f"  {layer:7s} {path}", file=sys.stderr)

for layer in ("system", "home"):
    if layer in layers:
        print(layer)
PY
